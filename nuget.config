<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- LocalPackages first: it can hold a repacked ClassicUs.GameLibs when the
         nuget.org copy is malformed (backslash paths inside the archive), which makes
         NuGet see zero assets in it. MarshAPI and Reactor are no longer consumed from
         a feed — they are vendored in this repo and built via ProjectReference. -->
    <add key="LocalPackages" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
