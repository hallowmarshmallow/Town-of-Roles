<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TownOfRoles</AssemblyName>
    <RootNamespace>TownOfRoles</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0626;CS0649;CS8632;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- These generated artifacts are present in the source checkout.  Without
         excluding them the SDK compiles both Debug and Release AssemblyInfo files,
         producing duplicate assembly attributes. -->
    <Compile Remove="UpdaterPatcher/**;obj/**;bin/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/OriginalTownOfUs/Roles/*.png" />
    <EmbeddedResource Include="Assets/OriginalTownOfUs/Resources/*.png" LogicalName="TownOfRoles.Assets.OriginalTownOfUs.Resources.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/OriginalTownOfUs/Resources/glitchbundle" LogicalName="TownOfRoles.Assets.OriginalTownOfUs.Resources.glitchbundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClassicUs.GameLibs" Version="2026.9.20.1" PrivateAssets="all" />

    <!-- MarshAPI and Reactor are separate sibling projects cloned alongside TownOfRoles -->
    <ProjectReference Include="../Reactor/Reactor.csproj" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="../MarshAPI/MarshAPI.csproj" />
  </ItemGroup>

  <!-- After a successful build, drop the plugin straight into the game's plugin folder
       when ClassicUsGameDir is set (e.g. an environment variable or -p:ClassicUsGameDir=...). -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(ClassicUsGameDir)' != ''">
    <MakeDir Directories="$(ClassicUsGameDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ClassicUsGameDir)\BepInEx\plugins" />
    <Message Importance="high" Text="Copied $(AssemblyName).dll -> $(ClassicUsGameDir)\BepInEx\plugins" />
  </Target>

</Project>
